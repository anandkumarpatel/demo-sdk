{
  "dxt_version": "0.2",
  "name": "readme-v2-mcp",
  "version": "0.1.0",
  "description": "The official MCP Server for the Readme V2 API",
  "author": {
    "name": "Readme V2",
    "email": "support@readme.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandkumarpatel/demo-sdk.git"
  },
  "homepage": "https://github.com/anandkumarpatel/demo-sdk/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.readme.com/main/docs/need-more-support",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "README_V2_API_KEY": "${user_config.README_V2_API_KEY}"
      }
    }
  },
  "user_config": {
    "README_V2_API_KEY": {
      "title": "api_key",
      "description": "A bearer token that will be supplied within an `Authentication` header as `bearer <token>`.",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
